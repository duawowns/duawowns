---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const title = Astro.props.title ?? "염재준";
const description = Astro.props.description ?? "Network Security Engineer portfolio";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${base}favicon.svg?v=transparent-01`} type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#content">본문으로 건너뛰기</a>
    <slot />

    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const loader = document.querySelector("#site-loader");
      const loaderProgress = document.querySelector(".site-loader__progress");
      const loaderPercent = document.querySelector(".site-loader__percent");
      const progress = document.querySelector(".scroll-progress");
      const navLinks = [...document.querySelectorAll(".floating-nav a")];
      const sections = [...document.querySelectorAll("section[id], footer[id]")];

      if (loader instanceof HTMLElement) {
        document.documentElement.classList.add("is-loading");
        const duration = reduceMotion.matches ? 1 : 1200;
        const startedAt = performance.now();

        const updateLoader = (now) => {
          const ratio = Math.min(1, (now - startedAt) / duration);
          const eased = 1 - Math.pow(1 - ratio, 3);
          const value = Math.round(eased * 100);

          if (loaderProgress instanceof HTMLElement) {
            loaderProgress.style.width = `${value}%`;
          }
          if (loaderPercent instanceof HTMLOutputElement) {
            loaderPercent.value = `${value}%`;
          }

          if (ratio < 1) {
            requestAnimationFrame(updateLoader);
            return;
          }

          window.setTimeout(() => {
            loader.classList.add("is-hidden");
            document.documentElement.classList.remove("is-loading");
            loader.setAttribute("aria-hidden", "true");
          }, reduceMotion.matches ? 0 : 400);
        };

        requestAnimationFrame(updateLoader);
      }

      navLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          const selector = link.getAttribute("href");
          const target = selector?.startsWith("#")
            ? document.querySelector(selector)
            : null;
          if (!(target instanceof HTMLElement)) return;

          event.preventDefault();
          history.pushState(null, "", selector);
          target.scrollIntoView({
            behavior: reduceMotion.matches ? "auto" : "smooth",
            block: "start",
          });
        });
      });

      const updatePageState = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const percentage = total > 0 ? Math.round((window.scrollY / total) * 100) : 0;
        if (progress) progress.textContent = `${Math.min(100, Math.max(0, percentage))}%`;

        let current = "work";
        for (const section of sections) {
          if (window.scrollY >= section.offsetTop - window.innerHeight * 0.42) {
            current = section.id;
          }
        }
        navLinks.forEach((link) => {
          const active = link.getAttribute("href") === `#${current}`;
          link.classList.toggle("active", active);
          if (active) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      };

      updatePageState();
      addEventListener("scroll", updatePageState, { passive: true });
      addEventListener("resize", updatePageState);
    </script>
  </body>
</html>
