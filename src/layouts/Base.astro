---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const title = Astro.props.title ?? "염재준";
const description = Astro.props.description ?? "Network Security Engineer portfolio";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#content">본문으로 건너뛰기</a>
    <slot />

    <script>
      const progress = document.querySelector(".scroll-progress");
      const navLinks = [...document.querySelectorAll(".floating-nav a")];
      const sections = [...document.querySelectorAll("section[id], footer[id]")];

      const updatePageState = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const percentage = total > 0 ? Math.round((window.scrollY / total) * 100) : 0;
        if (progress) progress.textContent = `${Math.min(100, Math.max(0, percentage))}%`;

        let current = "work";
        for (const section of sections) {
          if (window.scrollY >= section.offsetTop - window.innerHeight * 0.42) {
            current = section.id;
          }
        }
        navLinks.forEach((link) => {
          const active = link.getAttribute("href") === `#${current}`;
          link.classList.toggle("active", active);
          if (active) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      };

      updatePageState();
      addEventListener("scroll", updatePageState, { passive: true });
      addEventListener("resize", updatePageState);
    </script>
  </body>
</html>
