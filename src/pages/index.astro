---
import Base from "../layouts/Base.astro";
import { ArrowRight, ArrowUpRight } from "@lucide/astro";

const base = import.meta.env.BASE_URL;

const projects = [
  {
    title: "ZTNA Performance & Load Validation",
    period: "2026.03 — 2026.05",
    category: "Performance / Analysis",
    summary:
      "대규모 동시 접속 환경에서 제어 계층과 데이터 처리 경로를 분리해 병목과 실패 경계를 검증했습니다.",
    detail:
      "HA failover, 재시작·재연결, 동시 로그인과 세션 유지 시나리오에서 처리량, CPU·메모리, 성공률을 함께 추적했습니다.",
    image: `${base}images/ztna-performance.jpg`,
    size: "large",
  },
  {
    title: "ZTNA Operations CLI",
    period: "2026.03 — 2026.04",
    category: "Go / Operations",
    summary:
      "로그, 패킷, 세션, 제어 서버와 게이트웨이 상태를 한 흐름에서 확인하도록 운영 CLI와 진단 경로를 정리했습니다.",
    detail:
      "서비스 단위 추적과 패킷 필터링을 단순화하고, 중복 이벤트와 로그 노이즈를 줄여 핵심 신호를 빠르게 찾도록 개선했습니다.",
    image: `${base}images/operations-cli.jpg`,
    size: "small",
  },
  {
    title: "OpenZiti ZTNA Platform",
    period: "2025.06 — 2026.07",
    category: "ZTNA / OpenZiti",
    summary:
      "ZTNA 제어 서버와 게이트웨이의 정책·설정 반영 경로를 제품 구조에 맞춰 연결하고 실제 장비에서 검증했습니다.",
    detail:
      "서비스·단말·상태 기반 접근 정책과 Posture Check 평가 흐름을 검토하고 API, 로그, 서비스 상태, 설정 파일을 교차 확인했습니다.",
    image: `${base}images/openziti-platform.jpg`,
    size: "small",
  },
  {
    title: "IPsec VPN & strongSwan",
    period: "2022.01 — 2026.07",
    category: "VPN / Linux",
    summary:
      "XFRM state·policy, VICI 세션, strongSwan 로그와 실제 패킷을 함께 분석해 터널 상태와 데이터 경로 이상을 분리했습니다.",
    detail:
      "IKEv1·IKEv2, ESP, CHILD_SA, rekey, DPD·VRRP와 다양한 회선 조건을 검증하고 버전 변경, PQC·암호 모듈, 메모리 누수 회귀 시험을 수행했습니다.",
    image: `${base}images/security-appliance.jpg`,
    size: "large",
  },
];

const ledger = [
  {
    period: "2022 — NOW",
    title: "퓨쳐시스템",
    role: "IPsec VPN / ZTNA Engineer",
    note: "네트워크 보안 제품 개발 · 장애 분석 · 실장비 검증",
  },
  {
    period: "2024 — 2026",
    title: "동서울대학교",
    role: "AI Convergence Software",
    note: "AI융합소프트웨어학과 졸업",
  },
  {
    period: "2022 — 2024",
    title: "한국폴리텍대학 서울강서캠퍼스",
    role: "Information Security",
    note: "정보보안과 졸업",
  },
];

const achievements = [
  {
    type: "국가기술자격",
    date: "2021.09",
    title: "정보처리산업기사",
    description: "과정평가형 자격",
  },
  {
    type: "국가기술자격",
    date: "2021.07",
    title: "정보기기운용기능사",
    description: "정보통신 장비 운용 기반 역량",
  },
  {
    type: "국가기술자격",
    date: "2020.07",
    title: "정보처리기능사",
    description: "소프트웨어 개발 및 정보처리 기반 역량",
  },
  {
    type: "CORE STACK",
    date: "CURRENT",
    title: "Linux · C · Python · Go",
    description: "Shell · Bash · Docker · VMware · VPN",
  },
];
---

<Base
  title="염재준 — Network Security Engineer"
  description="IPsec VPN과 OpenZiti 기반 ZTNA를 개발하고 실제 Linux 보안 장비에서 성능, 장애, 접근 정책을 검증하는 네트워크 보안 엔지니어입니다."
>
  <div class="scroll-progress" aria-hidden="true">0%</div>

  <nav class="floating-nav" aria-label="주요 섹션">
    <a class="active" href="#work">Work</a>
    <a href="#history">Career</a>
    <a href="#achievements">Credentials</a>
    <a href="#contact">Contact</a>
  </nav>

  <main id="content">
    <section class="hero" aria-labelledby="hero-title">
      <p class="badge">Available for Collaboration</p>
      <h1 id="hero-title">Engineering secure access through precise validation.</h1>
      <div class="hero-meta">
        <p>
          IPsec VPN과 ZTNA 경험을 바탕으로 정책, API, 데이터 경로, 운영 도구,
          실장비 상태를 함께 확인하며 배포 전 리스크를 줄입니다.
        </p>
        <a class="button-pill" href="#work">VIEW CAREER <ArrowUpRight size={15} strokeWidth={2} /></a>
      </div>
    </section>

    <section id="work" class="content-section" aria-labelledby="work-title">
      <header class="section-heading">
        <span>(01)</span>
        <h2 id="work-title">Selected Works</h2>
      </header>

      <div class="work-grid">
        {
          projects.map((project) => (
            <article class:list={["work-card", project.size]}>
              <img src={project.image} alt="" loading="lazy" decoding="async" />
              <div class="work-overlay">
                <div class="work-tags">
                  <span class="badge">{project.category}</span>
                  <span class="badge">{project.period}</span>
                </div>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <p class="work-detail">{project.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="history" class="content-section" aria-labelledby="history-title">
      <header class="section-heading">
        <span>(02)</span>
        <h2 id="history-title">Career Ledger</h2>
      </header>

      <div class="ledger">
        {
          ledger.map((entry) => (
            <article class="ledger-row">
              <time>{entry.period}</time>
              <div>
                <h3>{entry.title}</h3>
                <p>{entry.note}</p>
              </div>
              <span>{entry.role}</span>
            </article>
          ))
        }
      </div>
    </section>

    <section id="achievements" class="content-section" aria-labelledby="achievement-title">
      <header class="section-heading">
        <span>(03)</span>
        <h2 id="achievement-title">Credentials</h2>
      </header>

      <div class="achievement-grid">
        {
          achievements.map((item) => (
            <article class="achievement-item">
              <div class="achievement-meta"><span>{item.type}</span><time>{item.date}</time></div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <footer id="contact">
    <p class="badge">Contact</p>
    <h2>Build secure systems<br />that hold up in reality.</h2>
    <div class="contact-actions">
      <a class="button-pill" href="mailto:wownsdl0129@gmail.com">SAY HELLO</a>
      <a class="circle-link" href="https://github.com/duawowns" aria-label="GitHub 프로필">
        <ArrowRight size={19} strokeWidth={1.6} />
      </a>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} YEOM JAEJUN</span>
      <span>SEOUL, KOREA / REMOTE</span>
      <span>NETWORK SECURITY / ZTNA / VPN</span>
    </div>
  </footer>
</Base>
